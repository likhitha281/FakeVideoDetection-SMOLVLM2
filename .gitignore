# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Checkpoints / model weights (large, regenerable — not committed)
checkpoints/
*.safetensors
*.bin
*.pt

# Data (regenerable from the HF dataset via the precompute pipeline)
exddv_frames/
*.mp4
*.flv

# Secrets — never commit tokens/keys
.env
*.token

# Logs / notebooks scratch
*.log
.ipynb_checkpoints/

# OS
.DS_Store

# HPC / Slurm runtime
logs/
*.out
*.err
slurm-*.out

# Hugging Face / model caches
hf_cache/
.cache/
huggingface/

# Local datasets — never commit video corpora
dataset/
datasets/
DF40/
df40_data/

# Large/resumable inference artifacts
evaluation/**/multitask_predictions.jsonl
